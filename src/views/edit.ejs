<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar post | Meu Blog</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: #f5f5f4;
            color: #1c1917;
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            padding: 0 16px;
        }

        header {
            background: #1c1917;
            color: #fafaf9;
            padding: 20px 0;
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.5rem;
        }

        header nav {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        header nav a:not(.btn):hover {
            color: #ea580c;
        }

        .btn {
            display: inline-block;
            background: #ea580c;
            color: #fff;
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }

        .btn:hover {
            background: #c2410c;
        }

        main {
            padding: 40px 0;
        }

        .back {
            display: inline-block;
            color: #78716c;
            margin-bottom: 24px;
        }

        .back:hover {
            color: #ea580c;
        }

        form {
            background: #fff;
            border: 1px solid #e7e5e4;
            border-radius: 8px;
            padding: 32px 24px;
        }

        form h2 {
            margin-bottom: 24px;
        }

        label {
            display: block;
            font-weight: 600;
            margin-bottom: 4px;
        }

        input,
        textarea {
            width: 100%;
            font: inherit;
            padding: 8px 12px;
            border: 1px solid #d6d3d1;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        input:focus,
        textarea:focus {
            outline: 2px solid #ea580c;
            border-color: transparent;
        }

        textarea {
            min-height: 240px;
            resize: vertical;
        }

        footer {
            text-align: center;
            color: #78716c;
            font-size: 0.875rem;
            padding: 24px 0;
            border-top: 1px solid #e7e5e4;
        }
    </style>
</head>

<body>
    <%- include('partials/header') %>

    <main class="container">
        <a href="/admin" class="back">← Voltar para o admin</a>

        <form action="/admin/edit/<%= post.id %>" method="POST">
            <h2>Editar post</h2>

            <label for="title">Título</label>
            <input type="text" id="title" name="title" value="<%= post.title %>" required>

            <label for="content">Conteúdo</label>
            <textarea id="content" name="content" required><%= post.content %></textarea>

            <button type="submit" class="btn">Salvar alterações</button>
        </form>
    </main>

    <%- include('partials/footer') %>
</body>

</html>