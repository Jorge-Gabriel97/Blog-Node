<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %> | Meu Blog</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: #f5f5f4;
            color: #1c1917;
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            padding: 0 16px;
        }

        header {
            background: #1c1917;
            color: #fafaf9;
            padding: 20px 0;
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.5rem;
        }

        .btn {
            display: inline-block;
            background: #ea580c;
            color: #fff;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
        }

        .btn:hover {
            background: #c2410c;
        }

        main {
            padding: 40px 0;
        }

        .back {
            display: inline-block;
            color: #78716c;
            margin-bottom: 24px;
        }

        .back:hover {
            color: #ea580c;
        }

        .post {
            background: #fff;
            border: 1px solid #e7e5e4;
            border-radius: 8px;
            padding: 32px 24px;
        }

        .post h2 {
            font-size: 2rem;
            line-height: 1.25;
            margin-bottom: 8px;
        }

        .post .meta {
            font-size: 0.875rem;
            color: #78716c;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #e7e5e4;
        }

        .post .content {
            white-space: pre-wrap;
            overflow-wrap: break-word;
        }

        footer {
            text-align: center;
            color: #78716c;
            font-size: 0.875rem;
            padding: 24px 0;
            border-top: 1px solid #e7e5e4;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <h1><a href="/">Meu Blog</a></h1>
            <a href="/posts/new" class="btn">Novo post</a>
        </div>
    </header>

    <main class="container">
        <a href="/" class="back">← Voltar para os posts</a>

        <article class="post">
            <h2><%= post.title %></h2>
            <p class="meta">
                Publicado em
                <time datetime="<%= post.createdAt.toISOString() %>">
                    <%= post.createdAt.toLocaleDateString('pt-BR') %>
                </time>
                <% if (post.updatedAt.getTime() !== post.createdAt.getTime()) { %>
                    · atualizado em
                    <time datetime="<%= post.updatedAt.toISOString() %>">
                        <%= post.updatedAt.toLocaleDateString('pt-BR') %>
                    </time>
                <% } %>
            </p>
            <div class="content"><%= post.content %></div>
        </article>
    </main>

    <footer>
        <div class="container">
            <p>© <%= new Date().getFullYear() %> Meu Blog</p>
        </div>
    </footer>
</body>
</html>
