<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Blog</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: #f5f5f4;
            color: #1c1917;
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: 760px;
            margin: 0 auto;
            padding: 0 16px;
        }

        header {
            background: #1c1917;
            color: #fafaf9;
            padding: 20px 0;
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.5rem;
        }

        .btn {
            display: inline-block;
            background: #ea580c;
            color: #fff;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
        }

        .btn:hover {
            background: #c2410c;
        }

        main {
            padding: 40px 0;
        }

        main h2 {
            margin-bottom: 24px;
        }

        .post {
            background: #fff;
            border: 1px solid #e7e5e4;
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 16px;
        }

        .post h3 {
            font-size: 1.25rem;
            margin-bottom: 4px;
        }

        .post h3 a:hover {
            color: #ea580c;
        }

        .post time {
            display: block;
            font-size: 0.875rem;
            color: #78716c;
            margin-bottom: 12px;
        }

        .post .read-more {
            display: inline-block;
            margin-top: 12px;
            color: #ea580c;
            font-weight: 600;
        }

        .empty {
            text-align: center;
            color: #78716c;
            padding: 48px 0;
        }

        .empty p {
            margin-bottom: 16px;
        }

        footer {
            text-align: center;
            color: #78716c;
            font-size: 0.875rem;
            padding: 24px 0;
            border-top: 1px solid #e7e5e4;
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <h1><a href="/">Meu Blog</a></h1>
            <a href="/posts/new" class="btn">Novo post</a>
        </div>
    </header>

    <main class="container">
        <h2>Últimos posts</h2>

        <% if (posts.length === 0) { %>
            <div class="empty">
                <p>Nenhum post publicado ainda.</p>
                <a href="/posts/new" class="btn">Escrever o primeiro</a>
            </div>
        <% } else { %>
            <% posts.forEach(post => { %>
                <article class="post">
                    <h3><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
                    <time datetime="<%= post.createdAt.toISOString() %>">
                        <%= post.createdAt.toLocaleDateString('pt-BR') %>
                    </time>
                    <p>
                        <%= post.content.length > 200 ? post.content.slice(0, 200) + '...' : post.content %>
                    </p>
                    <a href="/posts/<%= post.id %>" class="read-more">Ler mais →</a>
                </article>
            <% }) %>
        <% } %>
    </main>

    <footer>
        <div class="container">
            <p>© <%= new Date().getFullYear() %> Meu Blog</p>
        </div>
    </footer>
</body>
</html>
